# Any OpenAI-compatible chat endpoint. Measured 2026-10-21 (scripts/latency_probe.py):
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#            gemini-flash-lite-latest  TTFT ~0.6 s  -> live show loop
#            gemini-flash-latest       TTFT 18-38 s (thinking model) -> offline pipeline only
#   Groq:    https://api.groq.com/openai/v1           model e.g. llama-3.1-8b-instant
#   Ollama:  http://localhost:11434/v1                 model e.g. llama3.1 (no key needed)
# Model names get retired; list what your key can use via GET {LLM_BASE_URL}/models.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Offline pipeline stages (S4 bits, S5 annotation): quality over latency
PIPELINE_MODEL=gemini-flash-latest
# Show generator: bank (default, no key or quota) or llm (the model above + the LLM safety check).
# uvicorn does not read this file by itself; start it with --env-file:
#   .venv/Scripts/python -m uvicorn app.main:app --port 8000 --env-file .env
# With llm, a live room also needs the real slur list in app/blocklist.local.txt (gitignored);
# simulated rooms run without it.
GENERATOR=bank
# Claude instead of the OpenAI-compatible endpoint (Exp 24 compares them): LLM_PROVIDER=anthropic with
# LLM_MODEL=claude-haiku-5-5. The SDK reads the key itself; it is a paid key, never commit it.
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-haiku-5-5
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
